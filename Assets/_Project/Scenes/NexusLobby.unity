  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f6ba744d9f753ba44b9b533e62fa0004, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LobbyInteraction
  _player: {fileID: 1665369847}
  _stations:
  - anchor: {fileID: 839945469}
    title: 01 / INCURSAO
    description: 'Setor 01: Memoria Corrompida. Avance pelas salas, derrote o guardiao
      e extraia pelo portal dourado.'
    destinationScene: FirstSector
    weaponSelection: 0
  - anchor: {fileID: 966233553}
    title: 02 / FRAGMENTO
    description: "Este endere\xE7o ainda n\xE3o responde. Outros mundos ser\xE3o
      conectados ao Nexus conforme a jornada avan\xE7ar."
    destinationScene: 
    weaponSelection: 0
  - anchor: {fileID: 1502600139}
    title: 03 / ORIGEM
    description: "Este endere\xE7o ainda n\xE3o responde. Outros mundos ser\xE3o
      conectados ao Nexus conforme a jornada avan\xE7ar."
    destinationScene: 
    weaponSelection: 0
  - anchor: {fileID: 1920067947}
    title: ARSENAL / ARMAS
    description: "Escolha manopla, arco e flecha ou lan\xE7a antes da incurs\xE3o."
    destinationScene: 
    weaponSelection: 1
  - anchor: {fileID: 1255680661}
    title: "ARQUIVO / PERMISS\xC3O NEGADA"
    description: "Usu\xE1rio: externo. Origem: Terra. M\xE9todo de entrada: desconhecido.\n\nO
      sistema reconhece voc\xEA, mas os registros foram apagados. Cada incurs\xE3o
      pode recuperar um fragmento.\n\nComo escapar sem acesso ao c\xF3digo-fonte?"
    destinationScene: 
    weaponSelection: 0
  _interactionRange: 2.2
