--- !u!114 &1686289117
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1686289115}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ad5a9f41022caa041ba5cb886291754b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialDirector
  _player: {fileID: 337236274}
  _trainingWeapon: {fileID: 11400000, guid: 13662e278dc660b46a2edfe92a6262d0, type: 2}
  _target: {fileID: 952992004}
  _enemies:
  - {fileID: 743008797}
  - {fileID: 734937469}
  _movementGoal: {fileID: 348566686}
  _exit: {fileID: 2039536857}
  _marker: {fileID: 1382016683}
  _exitLight: {fileID: 225501236}
  _lobbyScene: NexusLobby
  _beats:
  - title: Reconecte os movimentos
    control: "BOT\xC3O DIREITO"
    instruction: "Clique no ch\xE3o e caminhe at\xE9 o marcador azul."
    transmission: "Sistemas em calibra\xE7\xE3o. Siga as luzes para acessar o Nexus."
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - title: Saia da linha de perigo
    control: "ESPA\xC7O"
    instruction: "Aponte para uma \xE1rea livre e execute uma esquiva."
    transmission: "Esquivar reposiciona voc\xEA. Observe a recarga na barra inferior."
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - title: Teste suas manoplas
    control: "BOT\xC3O ESQUERDO"
    instruction: "Aproxime-se do alvo e acerte 3 ataques b\xE1sicos. Mire perto dele:
      o cursor ajuda a direcionar o golpe."
    transmission: "Ataques b\xE1sicos n\xE3o gastam mana. Segure o bot\xE3o para
      continuar atacando."
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - title: Libere uma habilidade
    control: Q
    instruction: Aponte para o alvo e acerte com Q. Observe o gasto de mana e a recarga.
    transmission: "Q, W e E s\xE3o suas habilidades. Alterne golpes para carregar
      Asura, usada com R."
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - title: "Complete a simula\xE7\xE3o"
    control: ATAQUE + ESQUIVA
    instruction: "Derrote os dois drones. Saia das \xE1reas marcadas antes dos impactos."
    transmission: "Combine ataques e habilidades. Os drones desta calibra\xE7\xE3o
      causam pouco dano."
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - title: "Escolha sua evolu\xE7\xE3o"
    control: 1 / 2 / 3
    instruction: "Escolha um dos tr\xEAs modificadores. Leia o efeito e a habilidade
      afetada."
    transmission: "Nas incurs\xF5es, as escolhas se acumulam e criam novas combina\xE7\xF5es.
      Elas duram somente aquela run."
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - title: Entre no Nexus
    control: "BOT\xC3O DIREITO"
    instruction: "Caminhe at\xE9 o portal dourado. Voc\xEA tamb\xE9m pode testar
      seu novo modificador no alvo."
    transmission: "Calibra\xE7\xE3o conclu\xEDda. No Nexus, prepare seu equipamento
      e use o portal para iniciar uma incurs\xE3o."
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  _onCompleted:
    m_PersistentCalls:
      m_Calls: []
